# UTOP 환경 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 실제 비밀번호는 여기가 아니라
# .env 에만 두세요.

# ── 데이터베이스 (필수) ──────────────────────────────────────
# docker compose 가 이 값으로 PostgreSQL 을 만들고 백엔드에 물려줍니다.
POSTGRES_DB=utop
POSTGRES_USER=utop
POSTGRES_PASSWORD=여기에_DB_비밀번호_입력

# 도커를 쓰지 않고 직접 띄울 때만 필요합니다.
# (compose 를 쓰면 자동으로 조립됩니다)
# DATABASE_URL=postgresql://utop:비밀번호@localhost:5432/utop

# ── 접속 포트 ────────────────────────────────────────────────
# http://localhost:<WEB_PORT> 로 접속합니다.
WEB_PORT=8080

# ── Claude API (AI 기능 사용 시) ─────────────────────────────
ANTHROPIC_API_KEY=

# ── Dify 연동 (쓰는 경우만) ──────────────────────────────────
DIFY_BASE_URL=
DIFY_FILE_VAR=

# ── 백업 (tools/backup.py) ───────────────────────────────────
# 반드시 저장소 밖 경로를 지정하세요.
# UTOP_BACKUP_DIR=/var/backups/utop
# UTOP_BACKUP_KEEP=7

# ── Spirent TestCenter (윈도우에서 직접 실행할 때만) ─────────
# STCWEB_PATH=

TZ=Asia/Seoul
