# 이미지에 들어가면 안 되는 것 / 넣을 필요 없는 것
.git
.gitignore
.claude
.venv
__pycache__
**/__pycache__
*.pyc
node_modules
**/node_modules
web/dist

# 비밀정보 — 이미지에 절대 굽지 않는다. 런타임 환경변수로만 전달.
.env
.env.*
*.key
*.pem

# 데이터는 볼륨으로 물린다. 이미지에 굽지 않는다.
data/
_archive/
docs/
tests/
harness/
scripts/

# frontend/ 는 제외하지 않는다 —
# backend/main.py:85 의 StaticFiles(directory=frontend/static) 는 폴더가 없으면
# 기동 시 RuntimeError 로 죽는다. 새 UI 로 다 옮기기 전까지는 함께 실어야 한다.

# 백업·덤프
*.dump
*.log
